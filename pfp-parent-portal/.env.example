# Copy this file to .env and fill in real values before going live.
# With nothing filled in, the app still runs fully — emails/texts/pushes
# print to the console and billing marks itself "active" without charging
# a card ("dry run" mode) — so the whole app is testable for free first.

PORT=3000
APP_URL=http://localhost:3000

# Admin dashboard password (Basic Auth) — change this before deploying.
ADMIN_PASSWORD=changeme

# Signs parent login session cookies. Generate a real random value before
# deploying, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-generate-a-real-random-string

# --- Email (Resend: https://resend.com, free tier is generous) ---
RESEND_API_KEY=
RESEND_FROM="PFP Kickboxing Academy <hello@yourdomain.com>"

# --- SMS (Twilio: https://twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Billing (Square: https://squareup.com) ---
# Sandbox credentials are free and instant, no business verification needed to try it.
# From the Square Developer Dashboard (developer.squareup.com/apps) — Sandbox or Production Access Token.
SQUARE_ACCESS_TOKEN=
# Also from the Developer Dashboard (Locations tab) — which of your Square locations to bill under.
SQUARE_LOCATION_ID=
# "sandbox" while testing, "production" once you're ready to charge real cards.
SQUARE_ENVIRONMENT=sandbox
# From the Developer Dashboard once you add the webhook endpoint (see README).
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Push notifications (installed app) ---
# Generate a real pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:PFPkickboxingacademy@gmail.com

# --- Reminder / nurture timing ---
CLASS_REMINDER_MINUTES=60
EVENT_REMINDER_DAYS=3
LEAD_NUDGE_DAYS=3

# How often the reminder sweep runs (cron syntax). Default: every 5 minutes.
REMINDER_CRON_SCHEDULE="*/5 * * * *"
